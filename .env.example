NODE_ENV=development // required: development | production
PORT=3000
LOG_LEVEL=info

BASE_URL=http://playground-mock-service.local
API_SERVICE_URL=http://api-service.local
CONFIG_SERVICE_URL=http://config-service.local

REDIS_USERNAME=""
REDIS_HOST="localhost"
REDIS_PASSWORD=""
REDIS_PORT="6379"
REDIS_DB_0="0"
REDIS_DB_1="1"

RABBITMQ_URL=""
FINVU_AA_SERVICE_URL=http://finvu-aa-service.local
SKIP_MEETS_REQUIRMENTS

# FD (ONDC:FIS14:FD) only — read on first FD use
FD_SPEC=/path/to/ondc-fd-protocol.yaml
# FD_ROUTE_TABLE=/path/to/api-service/build-output/temp/config/fd_routes.yaml
# FD_SUBSCRIBER_ID=
# FD_SUBSCRIBER_URL_BASE=
# Required when the workbench plays the issuer (NP = BAP):
# FD_SIGNING_PRIVATE_KEY=
# FD_UNIQUE_KEY_ID=
# Registry for key lookups (needed when the workbench plays the investor app, to verify
# an issuer's quote signature):
# FD_REGISTRY_URL=
# PWB_INTERNAL_KEY=
